FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /opt/uts-mcp

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Keep example playbooks available in the test image too
COPY examples/ ./examples/

COPY entrypoint.dashboard-test.sh /usr/local/bin/entrypoint.dashboard-test.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.dashboard-test.sh && \
    chmod +x /usr/local/bin/entrypoint.dashboard-test.sh

RUN mkdir -p /opt/uts-mcp/output /opt/uts-mcp/logs /opt/uts-mcp/reports /opt/uts-mcp/data

EXPOSE 8080
EXPOSE 8090

ENTRYPOINT ["sh", "/usr/local/bin/entrypoint.dashboard-test.sh"]
